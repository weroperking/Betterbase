{
	"name": "@betterbase/cli",
	"version": "1.0.2",
	"private": false,
	"type": "module",
	"bin": {
		"bb": "./dist/index.js"
	},
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"exports": {
		".": "./dist/index.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "bun run src/build.ts",
		"prepublishOnly": "bun run build",
		"dev": "bun run src/index.ts",
		"test": "bun test",
		"typecheck": "tsc -p tsconfig.json --noEmit"
	},
	"engines": {
		"node": ">=18.0.0",
		"bun": ">=1.0.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/betterbase/betterbase.git"
	},
	"homepage": "https://github.com/betterbase/betterbase#readme",
	"license": "MIT",
	"keywords": [
		"betterbase",
		"cli",
		"backend",
		"database",
		"supabase",
		"bun"
	],
	"dependencies": {
		"chalk": "^5.3.0",
		"commander": "^12.1.0",
		"inquirer": "^10.2.2",
		"nanoid": "^5.0.0",
		"postgres": "^3.4.0",
		"zod": "^3.23.8",
		"cli-table3": "^0.6.5",
		"ora": "^8.0.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.9",
		"typescript": "^5.8.0"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
